bin/
build/
*.tmp
*.exe
*.dll
*.so
*.dylib
*.o
*.sock

# Anything that starts with a dot is tooling or local state, not part of the package ...
.*
# ... except these, which the repository needs:
!.github/
!.gitignore
# OpenSpec keeps each change's metadata in a dot file, and keeps empty directories with a placeholder
!.openspec.yaml
!.gitkeep
